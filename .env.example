# Kopieren nach .env.local und lokal ausfüllen. .env.local wird NICHT committet.
# Echte Werte für Produktion trägst du in Vercel ein (Project Settings → Environment Variables).

# Supabase (lokal: Ausgabe von `supabase status`; Produktion: Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig (Admin-Funktionen wie Passwort zurücksetzen). Niemals im Browser verwenden.
SUPABASE_SERVICE_ROLE_KEY=

# Öffentliche Basis-URL (für iCal-Links), lokal http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Betreiber für Impressum und Datenschutz (nur serverseitig). Bewusst nicht im Repo,
# weil es echte personenbezogene Daten sind. Fehlt ein Wert, zeigt die Seite einen Platzhalter.
IMPRESSUM_NAME=
IMPRESSUM_STRASSE=
IMPRESSUM_ORT=
IMPRESSUM_EMAIL=
# optional
IMPRESSUM_TELEFON=
